# ============================================
# 开发环境变量（npm run dev 时加载）
# 注意：变量名必须以 VITE_ 开头，才会被 Vite
# 注入到 import.meta.env 中（见 src/env.d.ts）
# ============================================

# 应用标题
VITE_APP_TITLE=React Admin Light (Development)

# API 基础地址（开发环境通常走 Vite 代理或相对路径）
VITE_API_BASE_URL=/api

# 接口超时时间（毫秒），axios 统一读取
VITE_API_TIMEOUT=15000

# 是否启用 MSW Mock（true 开启；开发环境默认开启）
VITE_USE_MOCK=true
