# ============================================
# 生产环境变量（npm run build 时加载）
# 注意：变量名必须以 VITE_ 开头，才会被 Vite
# 注入到 import.meta.env 中（见 src/env.d.ts）
# ============================================

# 应用标题
VITE_APP_TITLE=React Admin Light (Production)

# API 基础地址（生产环境域名，按实际部署修改）
VITE_API_BASE_URL=https://api.example.com

# 接口超时时间（毫秒），axios 统一读取
VITE_API_TIMEOUT=15000

# 是否启用 MSW Mock（生产环境固定关闭，构建时剔除 mock 代码）
VITE_USE_MOCK=false
